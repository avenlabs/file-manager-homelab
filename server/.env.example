# Salin jadi .env:  cp .env.example .env
# Password untuk login dari app
APP_PASSWORD=ganti-password-kuat
# String acak untuk tanda tangan token. Buat dengan: openssl rand -hex 32
TOKEN_SECRET=
# Folder di server yang akan diakses app (cek lokasi disk di CasaOS > Storage)
STORAGE_PATH=/DATA/Gallery
# Port yang dibuka di server
PORT=8088
# Masa berlaku login (jam). 720 = 30 hari
TOKEN_TTL_HOURS=720
TZ=Asia/Jakarta
