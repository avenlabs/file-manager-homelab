{
  "expo": {
    "name": "Casa Files",
    "slug": "avenlabs",
    "version": "0.4.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.joywibowo.casafiles",
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true,
          "NSAllowsLocalNetworking": true
        },
        "NSLocalNetworkUsageDescription": "Casa Files terhubung ke server CasaOS di jaringan lokal kamu.",
        "UIBackgroundModes": [
          "fetch"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.joywibowo.casafiles",
      "versionCode": 4
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "scheme": "casafiles",
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "Izinkan Casa Files memilih foto & video untuk di-upload ke CasaOS.",
          "cameraPermission": "Izinkan Casa Files memakai kamera untuk mengambil foto lalu upload.",
          "microphonePermission": "Izinkan Casa Files merekam audio saat merekam video."
        }
      ],
      "expo-secure-store",
      "expo-video",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Izinkan Casa Files menampilkan foto & video di HP kamu.",
          "savePhotosPermission": "Izinkan Casa Files menyimpan foto & video ke Galeri.",
          "granularPermissions": [
            "photo",
            "video"
          ]
        }
      ],
      "expo-web-browser"
    ],
    "extra": {
      "eas": {
        "projectId": "d1c363d3-09f3-4afe-8a0d-897bb434a38d"
      }
    }
  }
}
